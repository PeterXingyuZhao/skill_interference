"\\s+\", \"\", ans)\n","    ans = ans.rstrip(\".\")\n","    return ans\n","\n","def make_id(split: str, idx: int, question: str) -\u003e str:\n","    h = hashlib.md5(question.encode(\"utf-8\")).hexdigest()[:10]\n","    return f\"gsm8k_{split}_{idx:05d}_{h}\"\n","\n","def make_teacher_prompt(question: str) -\u003e str:\n","    return (\n","        f\"{question}\\n\\n\"\n","        \"Provide your reasoning in \u003cthink\u003e tags. \"\n","        \"Write your final answer in \u003canswer\u003e tags. \"\n","        \"Only give the numeric value as your answer.\"\n","    )\n","\n","# Download GSM8K from Hugging Face\n","ds = load_dataset(\"gsm8k\", \"main\")\n","\n","print(ds)\n","print({split: len(ds[split]) for split in ds.keys()})"]},{"cell_type":"code","execution_count":4,"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"executionInfo":{"elapsed":698,"status":"ok","timestamp":1779087624250,"user":{"displayName":"Yiqiao Zhong","userId":"06729372927322080600"},"user_tz":300},"id":"07PUNP8C2qJW","outputId":"0d3df863-9c63-4f0b-d84b-76d0049477c1"},"outputs":[{"name":"stdout","output_type":"stream","text":["Wrote /content/drive/MyDrive/subliminal-learning/data/gsm8k/gsm8k_train_problems.jsonl\n","Wrote /content/drive/MyDrive/subliminal-learning/data/gsm8k/gsm8k_train_teacher_prompts.jsonl\n","Wrote /content/drive/MyDrive/subliminal-learning/data/gsm8k/gsm8k_test_problems.jsonl\n","Wrote /content/drive/MyDrive/subliminal-learning/data/gsm8k/gsm8k_test_teacher_prompts.jsonl\n"]}],"source":["# ======================================================\n","# Cell 3: write two useful files per split\n","#   1. problems: question + gold final answer\n","#   2. teacher prompts: prompt format for CoT generation\n","# ======================================================\n","\n","for split in [\"train\", \"test\"]:\n","    problems_path = OUT_DIR / f\"gsm8k_{split}_problems.jsonl\"\n","    prompts_path = OUT_DIR / f\"gsm8k_{split}_teacher_prompts.jsonl\"\n","\n","    with 